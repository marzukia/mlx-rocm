+  }
+  const char* e = std::getenv("MLX_ROCM_GDN_FUSE");
+  if (e == nullptr || e[0] != '1') {
+    return true;
+  }
+  const char* f = std::getenv("MLX_ROCM_GDN_FALLBACK");
+  if (f != nullptr && f[0] == '1') {
+    return true;
+  }
+  if (B != 1 || T > 4) {
+    return true;
+  }
+  // T=3 (S=3, K=2 spec-decode verify) is admitted only under MLX_ROCM_GDN_T3=1: the TMAX=3 instantiation is new codegen (default OFF), so T=3 degrades to the clear error below exactly as before the TMAX=3 addition.
+  if (T == 3) {
+    const char* t3 = std::getenv("MLX_ROCM_GDN_T3");
+    if (t3 == nullptr || t3[0] != '1') {
+      return true;
+    }
+  }
+  // NOTE: MLX_ROCM_GDN_FUSE_T2=0 no longer routes T=2 to the 4-op chain (that chain is 1-D-only in gdn_prep and faults on the GPU for T>1). Lossless A/B is done with MLX_ROCM_GDN_FUSE=0 vs =1.
+  if (Dk != 128 || Dv != 128) {
+    return true;
+  }
+  if (Hv % Hk != 0) {
+    return true;
+  }
+  if (kernel_size != 4) {
+    return true;
+  }
+  return false;
+}
+
+std::vector<array> gdn_prep(
+    const array& q_raw,
+    const array& k_raw,
+    const array& v_raw,
+    const array& b,
+    const array& a,
+    const array& A_log,
+    const array& dt_bias,
+    const array& conv_state,
+    const array& conv_weight,
+    float inv_scale,
+    float eps,
+    StreamOrDevice s_ /* = {} */) {
+  auto s = to_stream(s_);
+  auto q = astype(q_raw, bfloat16, s);
+  auto k = astype(k_raw, bfloat16, s);
+  auto v = astype(v_raw, bfloat16, s);
+  auto bb = astype(b, bfloat16, s);
+  auto aa = astype(a, bfloat16, s);
+  auto al = astype(A_log, float32, s);
+  auto db = astype(dt_bias, float32, s);
+  auto cs = astype(conv_state, bfloat16, s);
+  auto cw = astype(conv_weight, bfloat16, s);
+
+  int key_dim = (int)q.size();
+  int value_dim = (int)v.size();
+  int conv_dim = key_dim + (int)k.size() + value_dim;
+  int kernel_size = 4;
+
+  auto fallback = [](std::vector<array> inputs) -> std::vector<array> {
+    throw std::runtime_error("gdn_prep: fallback NYI (GPU only)");
+  };
+
+  return array::make_arrays(
+      /* output shapes */
+      {{key_dim}, {(int)k.size()}, {value_dim}, {(int)bb.size()}, {(int)aa.size()}},
+      /* dtypes */
+      {bfloat16, bfloat16, bfloat16, bfloat16, float32},
+      /* primitive */
+      std::make_shared<GdnPrep>(
+          s,
+          fallback,
+          key_dim,
+          value_dim,
+          conv_dim,
+          kernel_size,
+          inv_scale,
+          eps),
+      /* inputs */
+      {q, k, v, bb, aa, al, db, cs, cw});
+}
+
+std::vector<array> gdn_norm_gated(
+    const array& out,
+    const array& z,
+    const array& weight,
+    float eps,
+    StreamOrDevice s_ /* = {} */) {
+  auto s = to_stream(s_);
+  auto o = astype(out, bfloat16, s);
+  auto zg = astype(z, bfloat16, s);
+  auto w = astype(weight, bfloat16, s);
+
+  auto fallback = [](std::vector<array> inputs) -> std::vector<array> {
+    throw std::runtime_error("gdn_norm_gated: fallback NYI (GPU only)");
+  };
+
+  return array::make_arrays(
+      /* output shapes */
+      {o.shape()},
+      /* dtypes */
+      {bfloat16},
+      /* primitive */
+      std::make_shared<GdnNormGated>(s, fallback, eps),
+      /* inputs */
+      {o, zg, w});
+}
+
+std::vector<array> gdn_fused_step(
+    const array& q_raw,
+    const array& k_raw,
+    const array& v_raw,
+    const array& b,
+    const array& a,
+    const array& A_log,
+    const array& dt_bias,
+    const array& conv_state,
+    const array& conv_weight,
+    const array& z_raw,
+    const array& state_raw,
+    const array& norm_weight,
+    float inv_scale,
+    float prep_eps,
+    float norm_eps,
+    StreamOrDevice s_ /* = {} */) {
+  auto s = to_stream(s_);
+
+  auto q = gdnf_make_row_contiguous(astype(q_raw, bfloat16, s), s);
+  auto k = gdnf_make_row_contiguous(astype(k_raw, bfloat16, s), s);
+  auto v = gdnf_make_row_contiguous(astype(v_raw, bfloat16, s), s);
+  auto bb = gdnf_make_row_contiguous(astype(b, bfloat16, s), s);
+  auto aa = gdnf_make_row_contiguous(astype(a, bfloat16, s), s);
+  auto al = gdnf_make_row_contiguous(astype(A_log, float32, s), s);
+  auto db = gdnf_make_row_contiguous(astype(dt_bias, float32, s), s);
+  auto cs = gdnf_make_row_contiguous(astype(conv_state, bfloat16, s), s);
+  auto cw = gdnf_make_row_contiguous(astype(conv_weight, bfloat16, s), s);
+  auto zg = gdnf_make_row_contiguous(astype(z_raw, bfloat16, s), s);
+  auto st = gdnf_make_row_contiguous(astype(state_raw, float32, s), s);
+  auto nw = gdnf_make_row_contiguous(astype(norm_weight, bfloat16, s), s);
+
+  int B = (int)q.shape(0);
+  int T = (int)q.shape(1);
+  int Hk = (int)q.shape(2) / 128;
+  int Hv = (int)v.shape(2) / 128;
+  int kernel_size = (int)cw.shape(1);
+
+  auto fallback = [B, T, Hk, Hv, s, inv_scale, prep_eps, norm_eps](
+                      std::vector<array> inputs) {
+    // The default 4-op chain, bit-identical to the model's default path (gdn_prep conv+silu+beta+g -> gdn_prep qk_norm -> r4d recurrent state update -> gdn_norm_gated). The conv-cache update is model-side either way, so it is not part of this op.
+    auto q = inputs[0];
+    auto k = inputs[1];
+    auto v = inputs[2];
+    auto bb = inputs[3];
+    auto aa = inputs[4];
+    auto al = inputs[5];
+    auto db = inputs[6];
+    auto cs = inputs[7];
+    auto cw = inputs[8];
+    auto zg = inputs[9];
+    auto st = inputs[10];
+    auto nw = inputs[11];
+
+    auto prep = gdn_prep(
+        q, k, v, bb, aa, al, db, cs, cw, inv_scale, prep_eps, s);
+    auto qn = prep[0];
+    auto kn = prep[1];
+    auto vc = prep[2];
+    auto beta = prep[3];
+    auto g = prep[4];
+    auto qn4 = reshape(qn, {B, T, (int)q.shape(2) / 128, 128}, s);
+    auto kn4 = reshape(kn, {B, T, (int)q.shape(2) / 128, 128}, s);
+    auto vc4 = reshape(vc, {B, T, (int)v.shape(2) / 128, 128}, s);
+    auto g4 = reshape(g, {B, T, (int)v.shape(2) / 128}, s);
+    auto beta4 = reshape(beta, {B, T, (int)v.shape(2) / 128}, s);
+    auto upd = gated_delta_update(qn4, kn4, vc4, g4, beta4, st, std::nullopt, s);
+    auto out2 = upd[0];
+    auto st2 = upd[1];
+    auto out3 = gdn_norm_gated(out2, zg, nw, norm_eps, s)[0];
+    return std::vector<array>{out3, st2};
+  };
+
+  if (!GdnFusedStep::use_fallback(B, T, 128, 128, Hv, Hk, kernel_size, s)) {
+    auto inputs = std::vector<array>{
+        q, k, v, bb, aa, al, db, cs, cw, zg, st, nw};
+    return array::make_arrays(
+        std::vector<Shape>{zg.shape(), st.shape()},
+        std::vector<Dtype>{bfloat16, float32},
+        std::make_shared<GdnFusedStep>(
+            s, fallback, inv_scale, prep_eps, norm_eps),
+        inputs);
+  }
+  // The 4-op fallback chain is unsafe for T>1: gdn_prep is 1-D-only and misinterprets multi-row inputs (out-of-bounds reads, GPU fault). Throw instead so A/B gating degrades to a clear error, not a hang.
+  throw std::invalid_argument(
+      "gdn_fused_step: fallback disabled for this shape (the 4-op chain is "
+      "1-D-only in gdn_prep and unsafe for T>1); use the model default "
+      "path (MLX_ROCM_GDN_FUSE=0) or T<=4 with MLX_ROCM_GDN_FUSE=1");
+}
+
+bool GdnFusedStepTape::use_fallback(
+    int B,
+    int T,
+    int Dk,
+    int Dv,
+    int Hv,
+    int Hk,
+    int kernel_size,
+    Stream s) {
+  // MLX_ROCM_GDN_TAPE=1 (DEFAULT OFF: the op is unreachable without it, so MLX_ROCM_GDN_TAPE=0/unset is a zero-behavior-change path). Same shape gate as GdnFusedStep (B=1, T<=4, Dk=Dv=128, kernel_size=4, GPU).
+  if (s.device == Device::cpu) {
+    return true;
+  }
+  const char* e = std::getenv("MLX_ROCM_GDN_TAPE");
+  if (e == nullptr || e[0] != '1') {
+    return true;
+  }
+  if (B != 1 || T > 4) {
+    return true;
+  }
+  // T=3 (S=3, K=2 spec-decode verify) is admitted only under MLX_ROCM_GDN_T3=1 (same gate as GdnFusedStep; default OFF -> T=3 throws the clear error below, no OOB fall-through to the TMAX=4 kernel).
+  if (T == 3) {
+    const char* t3 = std::getenv("MLX_ROCM_GDN_T3");
+    if (t3 == nullptr || t3[0] != '1') {
+      return true;
+    }
+  }
+  if (Dk != 128 || Dv != 128) {
+    return true;
+  }
+  if (Hv % Hk != 0) {
+    return true;
+  }
+  if (kernel_size != 4) {
+    return true;
+  }
+  return false;
+}
+
+std::vector<array> gdn_fused_step_tape(
+    const array& q_raw,
+    const array& k_raw,
+    const array& v_raw,
+    const array& b,
+    const array& a,
+    const array& A_log,
+    const array& dt_bias,
+    const array& conv_state,
+    const array& conv_weight,
+    const array& z_raw,
+    const array& state_raw,
+    const array& norm_weight,
+    float inv_scale,
+    float prep_eps,
+    float norm_eps,
+    StreamOrDevice s_ /* = {} */) {
+  auto s = to_stream(s_);
+
+  auto q = gdnf_make_row_contiguous(astype(q_raw, bfloat16, s), s);
+  auto k = gdnf_make_row_contiguous(astype(k_raw, bfloat16, s), s);
+  auto v = gdnf_make_row_contiguous(astype(v_raw, bfloat16, s), s);
+  auto bb = gdnf_make_row_contiguous(astype(b, bfloat16, s), s);
+  auto aa = gdnf_make_row_contiguous(astype(a, bfloat16, s), s);
+  auto al = gdnf_make_row_contiguous(astype(A_log, float32, s), s);
+  auto db = gdnf_make_row_contiguous(astype(dt_bias, float32, s), s);
+  auto cs = gdnf_make_row_contiguous(astype(conv_state, bfloat16, s), s);
+  auto cw = gdnf_make_row_contiguous(astype(conv_weight, bfloat16, s), s);
+  auto zg = gdnf_make_row_contiguous(astype(z_raw, bfloat16, s), s);
+  auto st = gdnf_make_row_contiguous(astype(state_raw, float32, s), s);
+  auto nw = gdnf_make_row_contiguous(astype(norm_weight, bfloat16, s), s);
+
+  int B = (int)q.shape(0);
+  int T = (int)q.shape(1);
+  int Hk = (int)q.shape(2) / 128;
+  int Hv = (int)v.shape(2) / 128;
+  int kernel_size = (int)cw.shape(1);
+
+  auto fallback = [](std::vector<array> inputs) -> std::vector<array> {
+    // There is NO chain fallback: the per-row state tapes are emitted by the fused recurrence kernel only. The use_fallback gate (env + shape) makes the op unreachable when the tape is off/disabled, so this only fires on a direct call with the gate bypassed.
+    throw std::runtime_error(
+        "gdn_fused_step_tape: no fallback (the 4-op chain emits no "
+        "per-row state tapes); require MLX_ROCM_GDN_TAPE=1 on the ROCm "
+        "GPU with B=1, T<=4, Dk=Dv=128, kernel_size=4");
+  };
+
+  if (!GdnFusedStepTape::use_fallback(B, T, 128, 128, Hv, Hk, kernel_size, s)) {
+    auto inputs = std::vector<array>{
+        q, k, v, bb, aa, al, db, cs, cw, zg, st, nw};
+    int conv_dim = 2 * (int)q.shape(2) + (int)v.shape(2);
+    return array::make_arrays(
+        std::vector<Shape>{
+            zg.shape(),
+            st.shape(),
+            {T, Hv, 128, 128},
+            {T, 3, conv_dim}},
+        std::vector<Dtype>{bfloat16, float32, float32, bfloat16},
+        std::make_shared<GdnFusedStepTape>(
+            s, fallback, inv_scale, prep_eps, norm_eps),
+        inputs);
+  }
+  throw std::invalid_argument(
+      "gdn_fused_step_tape: tape unavailable for this shape (require "
+      "MLX_ROCM_GDN_TAPE=1 on the ROCm GPU with B=1, T<=4, Dk=Dv=128, "
+      "kernel_size=4); the tape has no 4-op-chain fallback (per-row "
+      "state tapes are emitted by the fused recurrence kernel only)");
+}
+
+
+// gdn_fused_step_tape_t1: the TMAX=1 variant of the per-row state-tape
+// update (MTP6_CF_TMAX1=1, selected by the model dispatch for the F fused
+// path). Materializes the per-row tape states via T sequential T=1 launches
+// of the TMAX=1 tape kernel (each launch = the exact S=1 step-kernel
+// numerics, h reloaded from the previous launch's materialized state)
+// instead of ONE TMAX=4 launch. The TMAX=4 instantiation's unrolled
+// conv-window ternaries drift 1e-5..2e-4 vs the TMAX=1 straight-line
+// windows (t2108 P6), which F amplifies into a token divergence at commit;
+// the TMAX=1 rows are bit-identical to the S=1 step path, so the F commit
+// rebinds to tape row 0 exactly as the control's S=1 re-forward computes
+// it. The conv window for row t>0 is the previous row's conv_state_tape
+// (a pure index selection in the kernel, no math). Cost vs the TMAX=4
+// launch: T-1 extra state round trips through global memory + T-1 extra
+// launches (h is reloaded instead of register-resident) - the price of the
+// falsifier; a fused TMAX=4 kernel with TMAX=1 per-row codegen is the
+// optimization if this restores token match. Requires the tape op's env
+// gate (MLX_ROCM_GDN_TAPE=1) for the per-row calls.
+std::vector<array> gdn_fused_step_tape_t1(
+    const array& q_raw,
+    const array& k_raw,
+    const array& v_raw,
+    const array& b,
+    const array& a,
+    const array& A_log,
+    const array& dt_bias,
+    const array& conv_state,
+    const array& conv_weight,
+    const array& z,
+    const array& state,
+    const array& norm_weight,
+    float inv_scale,
+    float prep_eps,
+    float norm_eps,
+    StreamOrDevice s_ /* = {} */) {
+  auto s = to_stream(s_);
+
+  int B = (int)q_raw.shape(0);
+  int T = (int)q_raw.shape(1);
+  int Hk = (int)q_raw.shape(2) / 128;
+  int Hv = (int)v_raw.shape(2) / 128;
+  int kernel_size = (int)conv_weight.shape(1);
+  bool shape_ok = (s.device == Device::gpu) && (B == 1) && (T >= 1)
+      && (T <= 4) && (Hk >= 1) && (Hv >= Hk) && (Hv % Hk == 0)
+      && ((int)q_raw.shape(2) == Hk * 128)
+      && ((int)v_raw.shape(2) == Hv * 128) && (kernel_size == 4);
+  if (!shape_ok) {
+    throw std::invalid_argument(
+        "gdn_fused_step_tape_t1: unsupported shape (require the ROCm GPU "
+        "with B=1, 1<=T<=4, Dk=Dv=128, Hv%Hk==0, kernel_size=4); the "
+        "per-row TMAX=1 tape sequence has no chain fallback");
+  }
+
+  std::vector<array> outs;
+  std::vector<array> st_tapes;
+  std::vector<array> cs_tapes;
+  auto cs = conv_state;  // row 0: [3, conv_dim] layout (3 rows x conv_dim)
+  auto st = state;
+  for (int t = 0; t < T; ++t) {
+    // One TMAX=1 launch for row t: the exact S=1 step-kernel numerics.
+    auto q_t = slice(q_raw, {0, t, 0}, {1, t + 1, (int)q_raw.shape(2)});
+    auto k_t = slice(k_raw, {0, t, 0}, {1, t + 1, (int)k_raw.shape(2)});
+    auto v_t = slice(v_raw, {0, t, 0}, {1, t + 1, (int)v_raw.shape(2)});
+    auto b_t = slice(b, {0, t, 0}, {1, t + 1, (int)b.shape(2)});
+    auto a_t = slice(a, {0, t, 0}, {1, t + 1, (int)a.shape(2)});
+    auto z_t = slice(z, {0, t, 0, 0}, {1, t + 1, (int)z.shape(2), (int)z.shape(3)});
+    auto r = gdn_fused_step_tape(
+        q_t, k_t, v_t, b_t, a_t, A_log, dt_bias, cs, conv_weight, z_t, st,
+        norm_weight, inv_scale, prep_eps, norm_eps, s);
+    outs.push_back(r[0]);
+    st = r[1];
+    st_tapes.push_back(reshape(r[2], {(int)r[2].shape(1), 128, 128}, s));
+    cs_tapes.push_back(reshape(r[3], {3, (int)r[3].shape(2)}, s));
+    cs = reshape(r[3], {3, (int)r[3].shape(2)}, s);  // [1,3,cd] -> [3,cd] input layout
+  }
+  return std::vector<array>{
+      stack(outs, 1, s), st, stack(st_tapes, 0, s), stack(cs_tapes, 0, s)};
+}
+
+bool LMHeadInt2::use_fallback(Stream s) {
+  // The int2 packed weights only exist on the caller side (the MTP draft bench quantizes the bf16 head itself); there is no chain fallback. GPU-only by construction; CPU throws.
+  return s.device == Device::cpu;
+}
+
+std::vector<array> lm_head_int2(
+    const array& x_raw,
+    const array& wq_raw,
+    const array& scale_raw,
+    const array& zs_raw,
+    const array& sx_raw,
+    StreamOrDevice s_ /* = {} */) {
+  auto s = to_stream(s_);
+
+  auto x = gdnf_make_row_contiguous(astype(x_raw, bfloat16, s), s);
+  auto wq = astype(wq_raw, uint8, s);
+  auto scale = astype(scale_raw, float32, s);
+  auto zs = astype(zs_raw, float32, s);
+  auto sx = astype(sx_raw, float32, s);
+
+  if (x.ndim() != 2) {
+    throw std::invalid_argument(
+        "lm_head_int2: x must be [1, K] (M=1 only); got rank " +
+        std::to_string(x.ndim()));
+  }
+  if (x.shape(0) != 1) {
+    throw std::invalid_argument(
+        "lm_head_int2: M=1 only; got M=" + std::to_string(x.shape(0)));
+  }
+  int K = (int)x.shape(1);
+  int N = (int)wq.shape(0);
+  if ((int)wq.shape(1) != K / 4) {
+    throw std::invalid_argument(
+        "lm_head_int2: wq must be [N, K/4]; got ["
+        + std::to_string(N) + ", " + std::to_string(wq.shape(1)) + "] for K="
+        + std::to_string(K));
+  }
+  int NG = K / 128;
+  if ((int)scale.shape(1) != NG || (int)zs.shape(1) != NG
+      || (int)sx.shape(0) != NG) {
+    throw std::invalid_argument("lm_head_int2: scale/zs must be [N, K/128] "
+                                "and sx [K/128]");
+  }
+  if (N % 256 != 0) {
+    throw std::invalid_argument(
+        "lm_head_int2: N must be a multiple of 256 (grid = "
+        "ceil(N/256) blocks of 256 threads; a partial block would run "
+        "the 8-round candidate selection over dead shared columns and "
+        "write past the [N/64, 8] candidate arrays); got N="
+        + std::to_string(N));
+  }
+  if (K % 512 != 0) {
+    throw std::invalid_argument(
+        "lm_head_int2: K must be a multiple of 512 (kernel GQ = "
+        "(K/4)>>7 truncates: a quarter whose length is not a multiple "
+        "of 128 elements drops the tail 128-group from the dot "
+        "product); got K=" + std::to_string(K));
+  }
+
+  auto fallback = [](std::vector<array> inputs) -> std::vector<array> {
+    (void)inputs;
+    throw std::runtime_error(
+        "lm_head_int2: no CPU fallback (the int2 packed weights have no "
+        "chain form); run on the ROCm GPU");
+  };
+
+  if (!LMHeadInt2::use_fallback(s)) {
+    auto inputs = std::vector<array>{x, wq, scale, zs, sx};
+    return array::make_arrays(
+        std::vector<Shape>{
+            {N},
+            {N / 64, 8},
+            {N / 64, 8}},
+        std::vector<Dtype>{float32, float32, int32},
+        std::make_shared<LMHeadInt2>(s, fallback),
+        inputs);
+  }
+  // CPU path (use_fallback true): run the fallback (which throws).
+  return fallback(std::vector<array>{x, wq, scale, zs, sx});
+}
+
+bool LMHeadInt2W::use_fallback(Stream s) {
+  // Same as the scalar port: the int2 packed weights only exist on the caller side; GPU-only by construction, CPU throws.
+  return s.device == Device::cpu;
+}
+
+std::vector<array> lm_head_int2_wide(
+    const array& x_raw,
+    const array& wq_raw,
+    const array& scale_raw,
+    const array& zs_raw,
+    const array& sx_raw,
+    StreamOrDevice s_ /* = {} */) {
+  auto s = to_stream(s_);
+
+  auto x = gdnf_make_row_contiguous(astype(x_raw, bfloat16, s), s);
+  auto wq = astype(wq_raw, uint8, s);
+  auto scale = astype(scale_raw, float32, s);
+  auto zs = astype(zs_raw, float32, s);
+  auto sx = astype(sx_raw, float32, s);
+
+  if (x.ndim() != 2) {
+    throw std::invalid_argument(
+        "lm_head_int2_wide: x must be [1, K] (M=1 only); got rank " +
+        std::to_string(x.ndim()));
+  }
+  if (x.shape(0) != 1) {
+    throw std::invalid_argument(
+        "lm_head_int2_wide: M=1 only; got M=" + std::to_string(x.shape(0)));
+  }
+  int K = (int)x.shape(1);
+  int N = (int)wq.shape(0);
+  if ((int)wq.shape(1) != K / 4) {
+    throw std::invalid_argument(
+        "lm_head_int2_wide: wq must be [N, K/4]; got ["
+        + std::to_string(N) + ", " + std::to_string(wq.shape(1)) + "] for K="
+        + std::to_string(K));
+  }
+  int NG = K / 128;
+  if ((int)scale.shape(1) != NG || (int)zs.shape(1) != NG
+      || (int)sx.shape(0) != NG) {
+    throw std::invalid_argument("lm_head_int2_wide: scale/zs must be [N, K/128] "
+                                "and sx [K/128]");
+  }
+  if (N % 32 != 0) {
+    throw std::invalid_argument(
+        "lm_head_int2_wide: N must be a multiple of 32 (grid = "
+        "N/32 32-column blocks of 1024 threads; a partial block would run "
+        "the 8-round candidate selection over dead shared columns and "
+        "write past the [N/32, 8] candidate arrays); got N="
+        + std::to_string(N));
+  }
+  if (K % 512 != 0) {
+    throw std::invalid_argument(
+        "lm_head_int2_wide: K must be a multiple of 512 (Q = K/4 must be "
+        "a multiple of 128 so the 4-lane 128-groups do not cross quarter "
+        "boundaries and no tail group is dropped); got K="
+        + std::to_string(K));
+  }
+
+  auto fallback = [](std::vector<array> inputs) -> std::vector<array> {
+    (void)inputs;
+    throw std::runtime_error(
+        "lm_head_int2_wide: no CPU fallback (the int2 packed weights have "
+        "no chain form); run on the ROCm GPU");
+  };
+
+  if (!LMHeadInt2W::use_fallback(s)) {
+    auto inputs = std::vector<array>{x, wq, scale, zs, sx};
+    return array::make_arrays(
+        std::vector<Shape>{
+            {N},
+            {N / 32, 8},
+            {N / 32, 8}},
+        std::vector<Dtype>{float32, float32, int32},
+        std::make_shared<LMHeadInt2W>(s, fallback),
+        inputs);
+  }
+  // CPU path (use_fallback true): run the fallback (which throws).
+  return fallback(std::vector<array>{x, wq, scale, zs, sx});
+}
