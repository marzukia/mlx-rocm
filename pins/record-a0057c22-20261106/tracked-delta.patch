+template <typename T, int BLOCK_DIM, int N_READS = 4>
+__device__ void rms_norm_residual_row(
+    const T* x,
+    const T* r,
+    const T* w,
+    T* out,
+    float eps,
+    uint32_t axis_size,
+    int64_t w_stride) {
+  float normalizer = 0;
