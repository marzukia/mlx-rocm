+
+  rocm.def(
+      "rms_norm_residual",
+      [](const mx::array& x,
+         const mx::array& residual,
+         const mx::array& weight,
+         float eps,
+         mx::StreamOrDevice s) {
+        if (std::holds_alternative<std::monostate>(s)) {
+          s = mx::Device(mx::Device::gpu);
+        }
+        return mx::fast::rms_norm_residual(x, residual, weight, eps, s);
+      },
+      "x"_a, "residual"_a, "weight"_a, "eps"_a,
+      nb::kw_only(),
+      "stream"_a = nb::none(),
+      R"pbdoc(
