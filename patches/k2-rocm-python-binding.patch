+      )pbdoc");
+
+  rocm.def(
+      "kv_append",
+      [](const mx::array& keys,
+         const mx::array& values,
+         const mx::array& cache_keys,
+         const mx::array& cache_values,
+         int64_t offset,
+         mx::StreamOrDevice s) {
+        if (std::holds_alternative<std::monostate>(s)) {
+          s = mx::Device(mx::Device::gpu);
+        }
+        auto res = mx::fast::kv_append(
