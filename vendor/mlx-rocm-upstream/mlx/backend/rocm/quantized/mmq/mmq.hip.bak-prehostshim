static void mmq_q8_0_q4_k(
    const char* x, const char* y, const float* y_scale,
    float* dst, int M, int N, int K, hipStream_t stream) {
  ggml_backend_cuda_context ctx(0);  // the device 0 (the gfx1201)
  const int cc = 1201;  // the gfx1201 compute capability
  const size_t smpbo = 0;
  const bool fallback = ggml_cuda_mmq_needs_fallback(M);
  const ggml_prec prec_src1 = GGML_PREC_Q8;
  int nthreads_best = 0;
  const int J_best = ggml_cuda_mmq_get_J_best(GGML_TYPE_Q4_K, N, fallback, cc, smpbo, prec_src1, &nthreads_best);
  mmq_args args = { x, GGML_TYPE_Q4_K, (const int*)y, nullptr, nullptr, dst,
      y_scale, K, M, N, K, N, N,
      1, 1, 0, 0, 0,
      1, 1, 0, 0, 0,
      N, J_best, {} };
  mul_mat_q_case<GGML_TYPE_Q4_K, GGML_PREC_Q8>(ctx, args, stream);
}
}  // namespace rocm
